# Silo — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# Only EXPO_PUBLIC_* vars are exposed to the app bundle (Expo inlines them at
# build time — restart Metro / rebuild after changing them).

# Base URL of the deployed Cloudflare Worker (silo-api). Leave blank to run the
# app fully offline (AI/audio features degrade gracefully). Fill in after deploy:
#   https://silo-api.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_BASE_URL=

# Shared client token that gates the backend against anonymous abuse. Must match
# the worker's APP_CLIENT_TOKEN secret exactly. Generate with:
#   openssl rand -hex 32
EXPO_PUBLIC_CLIENT_TOKEN=

# --- Accounts (OPTIONAL) ---------------------------------------------------
# Leave BOTH blank and the app runs exactly as it does today: fully on-device,
# no account surface anywhere, sync by pairing code. Fill them in to enable
# "Mode 2" (docs/sync.md) — Sign in with Apple / Google / email code, and a
# stable sync space per user.
#
# The identity provider only ever holds an email address and a user id. Saves
# go to YOUR Worker + D1, never to it.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Subscriptions (OPTIONAL) ----------------------------------------------
# Leave blank and billing is off: no paywall, no subscription UI, and every
# premium gate opens — the app behaves exactly as it did before billing
# existed. Fill in to turn on Silo Premium (RevenueCat public SDK keys; safe in
# the bundle, they can only read/purchase for the signed-in store account).
#
# Requires a development or EAS build — react-native-purchases is a native
# module and cannot run in Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
