# Copy to `.env.local` (gitignored) and fill in.
#
# The WXT_ PREFIX IS LOAD-BEARING. WXT/Vite only inject prefixed vars into the
# bundle, so an unprefixed name leaves API_BASE = '' at runtime — which shows
# up as "Preview unavailable" on every page and "No sync server configured"
# in the sync modal, with nothing in the console to explain why.
#
# Both values mirror the phone app's EXPO_PUBLIC_* pair in the repo-root `.env`
# — the extension talks to the SAME Cloudflare Worker.

WXT_SILO_API_BASE_URL=https://your-worker.workers.dev
WXT_SILO_CLIENT_TOKEN=your-shared-client-token
